# ==============================================================================
# UnifiedCommunication Softphone .gitignore
# ==============================================================================

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor and IDE directories
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment & local credentials
.env
.env.local
.env.*.local

# Node / Electron build artifacts
node_modules/
dist/
dist-electron/
release/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# C++ & Object files
*.o
*.obj
*.d
*.a
*.so
*.dylib
*.dll
*.exe

# PJSIP compiled source and downloads
pjproject-*/
*.tar.gz
*.tar.bz2

# PJSIP Daemon binaries and build directories
pjsip-daemon/bin/
pjsip-daemon/build/
pjsip-daemon/src/*.o
pjsip-daemon/CMakeCache.txt
pjsip-daemon/CMakeFiles/
pjsip-daemon/cmake_install.cmake
pjsip-daemon/Makefile.in

# Logs
*.log
